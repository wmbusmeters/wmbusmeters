driver {
    name           = ebeco500
    meter_type     = ElectricityMeter
    default_fields = name,id,total_energy_consumption_kwh,temperature_c,on_time_h,status,timestamp
    detect {
        mvt = EBE,02,01
    }
    fields {
        field {
            name     = total_energy_consumption
            quantity = Energy
            info     = 'Total energy consumption recorded by Ebeco thermostat.'
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
            }
        }
        field {
            name     = temperature
            quantity = Temperature
            info     = 'Current thermostat temperature.'
            match {
                measurement_type = Instantaneous
                vif_range        = ExternalTemperature
            }
        }
        field {
            name     = on_time
            quantity = Time
            info     = 'Total operating/heating time.'
            match {
                measurement_type = Instantaneous
                vif_range        = OnTime
            }
        }
        field {
            name       = status
            quantity   = Text
            info       = 'Thermostat error and status flags.'
            attributes = STATUS
            match {
                difvifkey = 02FB17
            }
            bit_field {
                mask = 0xffff
                default_message = OK
                bit {
                    pos = 0
                    label = TEMPORARY
                }
                bit {
                    pos = 1
                    label = MIN_LIMIT
                }
                bit {
                    pos = 2
                    label = MAX_LIMIT
                }
                bit {
                    pos = 3
                    label = OPEN_WINDOW
                }
                bit {
                    pos = 4
                    label = ROOM_OC
                }
                bit {
                    pos = 5
                    label = ROOM_SC
                }
                bit {
                    pos = 6
                    label = FLOOR_OC
                }
                bit {
                    pos = 7
                    label = FLOOR_SC
                }
                bit {
                    pos = 8
                    label = RELAY_OC
                }
                bit {
                    pos = 9
                    label = RELAY_SC
                }
                bit {
                    pos = 10
                    label = RELAY_OT
                }
                bit {
                    pos = 11
                    label = SYSTEM
                }
                bit {
                    pos = 12
                    label = STARTUP
                }
                bit {
                    pos = 13
                    label = POWER_CTRL
                }
                bit {
                    pos = 14
                    label = POWER_OFF
                }
                bit {
                    pos = 15
                    label = RELAY_TEST
                }
            }
        }
    }
}
tests {
        test {
            args     = 'Golvvarme ebeco500 000001e3 FCC9B808216D9D1F5FF6E1A3CF7D3084'
            telegram = 31444514e301000001028c20807a2e002025e25dea4f2bc8ec94920260443a95c2bf3856e3e380e889cc8233ca5d9771f289
            json     = '{"_":"telegram","media":"electricity","meter":"ebeco500","name":"Golvvarme","id":"000001e3","on_time_h":105.633333,"temperature_c":22.8,"total_energy_consumption_kwh":68.6,"status":"OK","timestamp":"1111-11-11T11:11:11Z"}'
            fields   = 'Golvvarme;000001e3;68.6;22.8;105.633333;OK;1111-11-11 11:11.11'
        }
    }
