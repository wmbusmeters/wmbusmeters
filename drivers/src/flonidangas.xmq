driver {
    name           = flonidangas
    meter_type     = GasMeter
    default_fields = name,id,status,timestamp
    manufacturer   = Flonidan
    detect {
        mvt = FLO,50,03
    }
    fields {
        field {
            name       = status
            quantity   = Text
            info       = 'Status and error flags.'
            attributes = STATUS,INCLUDE_TPL_STATUS
        }
    }
    tests {
        test {
            args     = 'GasMeter flonidangas 12345678 NOKEY'
            telegram = 26448F197856341250037A23230129_0600000B004F837AAB646E32C56C7168866EB387CCA0BF10
            json     = '{"_":"telegram","media":"gas","meter":"flonidangas","name":"GasMeter","id":"12345678","status":"ALARM UNKNOWN_20","timestamp":"1111-11-11T11:11:11Z"}'
            fields   = 'GasMeter;12345678;ALARM UNKNOWN_20;1111-11-11 11:11.11'
        }
    }
}
