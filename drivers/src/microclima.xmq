driver {
    name           = microclima
    meter_type     = HeatMeter
    default_fields = name,id,status,total_energy_consumption_kwh,total_volume_m3,timestamp
    manufacturer   = Maddalena
    detect {
        mvt = MAD,00,04
        mvt = MAD,00,0c
        mvt = MAD,00,0d
    }
    library {
        use = meter_datetime,model_version,parameter_set
        use = flow_temperature_c,return_temperature_c
    }
    fields {
        field {
            name       = status
            quantity   = Flags
            info       = 'Meter status from error flags and tpl status field.'
            attributes = STATUS,INCLUDE_TPL_STATUS
            match {
                measurement_type = Instantaneous
                vif_range        = ErrorFlags
            }
            lookup {
                name            = ERROR_FLAGS
                map_type        = BitToString
                mask_bits       = 0xffff
                default_message = OK
            }
        }
        field {
            name           = total_energy_consumption
            quantity       = Energy
            info           = 'The total heat energy consumption recorded by this meter.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
            }
        }
        field {
            name           = total_cooling_energy_consumption
            quantity       = Energy
            info           = 'The total energy recorded in tariff 1 (presumably cooling) by this meter.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                tariff_nr        = 1
            }
        }
        field {
            name           = total_volume
            quantity       = Volume
            info           = 'The total heating media volume recorded by this meter.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = Volume
            }
        }
        field {
            name           = volume_flow
            quantity       = Flow
            info           = 'The current heat media volume flow.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = VolumeFlow
            }
        }
        field {
            name           = power
            quantity       = Power
            info           = 'The current power consumption.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = PowerW
            }
        }
        field {
            name           = temperature_difference
            quantity       = Temperature
            info           = 'The difference between flow and return media temperatures.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = TemperatureDifference
            }
        }
        field {
            name           = set
            quantity       = PointInTime
            info           = 'The most recent billing period date.'
            attributes     = HIDE
            vif_scaling    = Auto
            dif_signedness = Signed
            display_unit   = date
            match {
                measurement_type = Instantaneous
                vif_range        = Date
                storage_nr       = 1
            }
        }
        field {
            name           = 'consumption_at_set_date_{storage_counter}'
            quantity       = Energy
            info           = 'The total water consumption at the historic date.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                storage_nr       = 1,31
            }
        }
        field {
            name         = 'set_date_{storage_counter}'
            quantity     = PointInTime
            info         = 'Unclear! What is the date really?'
            display_unit = date
            calculate    = 'set_date - ((storage_counter-1counter) * 1 month)'
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                storage_nr       = 1,31
            }
        }
        field {
            name           = 'cooling_consumption_at_set_date_{storage_counter}'
            quantity       = Energy
            info           = 'The energy recorded in tariff 1 (presumably cooling) at the historic date.'
            vif_scaling    = Auto
            dif_signedness = Signed
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                tariff_nr        = 1
                storage_nr       = 1,31
            }
        }
    }
    tests {
        test {
            args     = 'Heat microclima 93572431 NOKEY'
            telegram = 494424343124579300047a5a0000202f2f046d2720b62c04060d07000001fd170004130a8c0400043b00000000042b00000000025b1500025f15000261d0ff03fd0c05000002fd0b1011
            json     = '{"_":"telegram","flow_temperature_c":21,"id":"93572431","media":"heat","driver":"microclima","meter_datetime":"2021-12-22 00:39","model_version":"000005","name":"Heat","parameter_set":"1110","power_kw":0,"return_temperature_c":21,"status":"OK","temperature_difference_c":-0.48,"timestamp":"1111-11-11T11:11:11Z","total_energy_consumption_kwh":1805,"total_volume_m3":297.994,"volume_flow_m3h":0}'
            fields   = 'Heat;93572431;OK;1805;297.994;1111-11-11 11:11.11'
        }
        test {
            args     = 'Heat microclima 93573086 NOKEY'
            telegram = 
            json     = '{"_":"telegram","consumption_at_set_date_11_kwh":1803,"consumption_at_set_date_13_kwh":1803,"consumption_at_set_date_15_kwh":1803,"consumption_at_set_date_17_kwh":1701,"consumption_at_set_date_19_kwh":1527,"consumption_at_set_date_1_kwh":1222,"consumption_at_set_date_21_kwh":1402,"consumption_at_set_date_23_kwh":1295,"consumption_at_set_date_25_kwh":1222,"consumption_at_set_date_27_kwh":1087,"consumption_at_set_date_29_kwh":955,"consumption_at_set_date_31_kwh":677,"consumption_at_set_date_3_kwh":1984,"consumption_at_set_date_5_kwh":1847,"consumption_at_set_date_7_kwh":1809,"consumption_at_set_date_9_kwh":1803,"id":"93573086","media":"heat","driver":"microclima","meter_datetime":"2021-12-22 01:07","model_version":"000005","name":"Heat","parameter_set":"1111","set_date_11_date":"2020-02-29","set_date_13_date":"2019-12-31","set_date_15_date":"2019-10-31","set_date_17_date":"2019-08-31","set_date_19_date":"2019-06-30","set_date_1_date":"2020-12-31","set_date_21_date":"2019-04-30","set_date_23_date":"2019-02-28","set_date_25_date":"2018-12-31","set_date_27_date":"2018-10-31","set_date_29_date":"2018-08-31","set_date_31_date":"2018-06-30","set_date_3_date":"2020-10-31","set_date_5_date":"2020-08-31","set_date_7_date":"2020-06-30","set_date_9_date":"2020-04-30","status":"OK","timestamp":"1111-11-11T11:11:11Z","total_energy_consumption_kwh":2119,"total_volume_m3":241.757}'
            fields   = 'Heat;93573086;OK;2119;241.757;1111-11-11 11:11.11'
        }
        test {
            args     = 'Heat microclima 33758504 NOKEY'
            comment  = MAD,00,0c
            telegram = 
            json     = '{"_":"telegram","media":"heat volume at inlet","driver":"microclima","name":"Heat","id":"33758504","consumption_at_set_date_1_kwh":226.944444,"consumption_at_set_date_11_kwh":0,"consumption_at_set_date_13_kwh":0,"consumption_at_set_date_15_kwh":0,"consumption_at_set_date_17_kwh":0,"consumption_at_set_date_19_kwh":0,"consumption_at_set_date_21_kwh":0,"consumption_at_set_date_23_kwh":0,"consumption_at_set_date_25_kwh":0,"consumption_at_set_date_27_kwh":0,"consumption_at_set_date_29_kwh":0,"consumption_at_set_date_3_kwh":1020.555556,"consumption_at_set_date_31_kwh":0,"consumption_at_set_date_5_kwh":899.444444,"consumption_at_set_date_7_kwh":713.055556,"consumption_at_set_date_9_kwh":226.944444,"set_date_1_date":"2023-12-31","set_date_11_date":"2023-02-28","set_date_13_date":"2022-12-31","set_date_15_date":"2022-10-31","set_date_17_date":"2022-08-31","set_date_19_date":"2022-06-30","set_date_21_date":"2022-04-30","set_date_23_date":"2022-02-28","set_date_25_date":"2021-12-31","set_date_27_date":"2021-10-31","set_date_29_date":"2021-08-31","set_date_3_date":"2023-10-31","set_date_31_date":"2021-06-30","set_date_5_date":"2023-08-31","set_date_7_date":"2023-06-30","set_date_9_date":"2023-04-30","total_energy_consumption_kwh":1101.388889,"total_volume_m3":124.518,"meter_datetime":"2024-04-25 15:15","model_version":"000105","parameter_set":"1101","status":"OK","timestamp":"1111-11-11T11:11:11Z"}'
            fields   = 'Heat;33758504;OK;1101.388889;124.518;1111-11-11 11:11.11'
        }
        test {
            args     = 'Cool microclima 30758972 NOKEY'
            comment  = 'MAD,00,0d heat/cooling meter'
            telegram = 
            json     = '{"_":"telegram","media":"heat/cooling load","driver":"microclima","name":"Cool","id":"30758972","cooling_consumption_at_set_date_1_kwh":78,"cooling_consumption_at_set_date_11_kwh":281,"cooling_consumption_at_set_date_13_kwh":264,"cooling_consumption_at_set_date_15_kwh":210,"cooling_consumption_at_set_date_17_kwh":207,"cooling_consumption_at_set_date_19_kwh":207,"cooling_consumption_at_set_date_21_kwh":173,"cooling_consumption_at_set_date_23_kwh":116,"cooling_consumption_at_set_date_25_kwh":78,"cooling_consumption_at_set_date_27_kwh":13,"cooling_consumption_at_set_date_29_kwh":2,"cooling_consumption_at_set_date_3_kwh":923,"cooling_consumption_at_set_date_31_kwh":0,"cooling_consumption_at_set_date_5_kwh":920,"cooling_consumption_at_set_date_7_kwh":919,"cooling_consumption_at_set_date_9_kwh":904,"total_cooling_energy_consumption_kwh":926,"meter_datetime":"2024-12-26 07:37","model_version":"000105","parameter_set":"2201","status":"OK","timestamp":"1111-11-11T11:11:11Z"}'
            fields   = 'Cool;30758972;OK;null;null;1111-11-11 11:11.11'
        }
    }
}
