driver {
    name           = brunatawm
    meter_type     = WaterMeter
    default_fields = name,id,status,total_m3,target_m3,timestamp
    detect {
        mvt = DWZ,01,06
    }
    library {
        use = total_m3
        use = target_m3
        use = target_date
        use = meter_date
    }
    fields {
        field {
            name       = status
            quantity   = Text
            info       = 'Status and error flags.'
            attributes = STATUS,INCLUDE_TPL_STATUS
        }
    }
    tests {
        test {
            args     = 'X brunatawm 21117187 NOKEY'
            telegram = 3E44FA128771112101067ABA0020252F2F041377E50000026C5036426C3F3C44137AB900002F2F2F2F2F2F2F2F2F2F0F800C000109003DBF0100209A31414D
            json     = '{"_": "telegram","id": "21117187","media": "warm water","driver": "brunatawm","meter_date": "2026-06-16","name": "X","status": "OK","target_date": "2025-12-31","target_m3": 47.482,"timestamp": "1111-11-11T11:11:11Z","total_m3": 58.743}'
            fields   = 'X;21117187;OK;58.743;47.482;1111-11-11 11:11.11'
        }
    }
}
