// XEEny from XEE Technology is an optical reader that is clipped onto an electricity meter.
// It reads the meter through its IR interface and builds the wM-Bus telegram itself.
// The dll carries the XEEny (XEE,02,37) and its own id. When a meter is detected,
// a long tpl carries the identity of that meter (e.g. ESY,11,02 or DZG,00,02) and the
// output id is the meter id. Without a meter the XEEny sends a short tpl and its own id.
// The application layer is always built by the XEEny, therefore the driver is detected
// with a dll_mvt, independent of the meter behind it.
driver {
    name           = xeeny
    meter_type     = ElectricityMeter
    default_fields = name,id,status,total_energy_consumption_kwh,total_energy_production_kwh,timestamp
    manufacturer   = 'XEE Technology'
    detect {
        dll_mvt = XEE,02,37
    }
    mfct_tpl_status_bits {
        // Bit 7 only says the XEEny was reset manually at some point and is sent
        // during installation mode only. XEE says it can be ignored, so it is masked out.
        mask_bits       = 0x60
        default_message = OK
        map {
            name  = INSTALLATION_MODE
            info  = 'Meter detection is running (green blinking), for up to 30 minutes after activation and every 12 hours while no meter is found.'
            value = 0x20
            test  = Set
        }
        map {
            name  = INTERNAL_ERROR_6
            value = 0x40
            test  = Set
        }
    }
    library {
        use = actuality_duration_s,meter_datetime
    }
    fields {
        field {
            name       = status
            quantity   = Text
            info       = 'Status and error flags of the XEEny.'
            attributes = REQUIRED,STATUS,INCLUDE_TPL_STATUS
            match {
                measurement_type = Instantaneous
                vif_range        = ErrorFlags
            }
            lookup {
                name            = ERROR_FLAGS
                map_type        = BitToString
                mask_bits       = 0xffff
                default_message = OK
                map {
                    name  = LOW_BATTERY
                    info  = 'Battery of the XEEny is low.'
                    value = 0x0002
                    test  = Set
                }
                map {
                    name  = METER_READOUT_FAILED
                    info  = 'A detected meter can no longer be read. Resets when reading works again.'
                    value = 0x0020
                    test  = Set
                }
                map {
                    name  = INVALID_METER_ID
                    info  = 'The meter sent an invalid id.'
                    value = 0x0100
                    test  = Set
                }
                map {
                    name  = METER_DETECTION_FAILED
                    info  = 'No meter detected within 30 minutes of installation mode. Detection is retried every 12 hours, the flag resets on success.'
                    value = 0x0200
                    test  = Set
                }
                map {
                    name  = INTERNAL_ERROR_2
                    value = 0x0400
                    test  = Set
                }
                map {
                    name  = INTERNAL_ERROR_3
                    value = 0x0800
                    test  = Set
                }
                map {
                    name  = INTERNAL_ERROR_4
                    value = 0x1000
                    test  = Set
                }
                map {
                    name  = NO_SCALING_FROM_METER
                    info  = 'The meter sends no scaling, kWh is assumed. Compare once with the meter display.'
                    value = 0x2000
                    test  = Set
                }
            }
        }
        field {
            name     = total_energy_consumption
            quantity = Energy
            info     = 'The total energy consumption (OBIS 1.8.0) read from the meter.'
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                tariff_nr        = 0
            }
        }
        field {
            name     = 'total_energy_consumption_tariff_{tariff_counter}'
            quantity = Energy
            info     = 'The energy consumption per tariff (OBIS 1.8.x) read from the meter.'
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                tariff_nr        = 1,3
            }
        }
        field {
            name     = total_energy_production
            quantity = Energy
            info     = 'The total energy production (OBIS 2.8.0) read from the meter.'
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                add_combinable   = BackwardFlow
                tariff_nr        = 0
            }
        }
        field {
            name     = 'total_energy_production_tariff_{tariff_counter}'
            quantity = Energy
            info     = 'The energy production per tariff (OBIS 2.8.x) read from the meter.'
            match {
                measurement_type = Instantaneous
                vif_range        = AnyEnergyVIF
                add_combinable   = BackwardFlow
                tariff_nr        = 1,3
            }
        }
        field {
            name     = device_temperature
            quantity = Temperature
            info     = 'Temperature of the XEEny itself, sent with the external temperature vif.'
            match {
                measurement_type = Instantaneous
                vif_range        = ExternalTemperature
            }
        }
        field {
            name     = firmware_version
            quantity = Text
            info     = 'Firmware version of the XEEny, sent from firmware 1.5.0.'
            match {
                measurement_type = Instantaneous
                vif_range        = SoftwareVersion
            }
        }
    }
    tests {
        test {
            args     = 'XEEny xeeny 00000019 33112233445566778899AABBCCDDEEEE'
            comment  = 'XEEny without meter, short tpl with the XEEny id. Example from the XEE documentation, security profile B.'
            telegram = 4344A560190000000237_8C2080900F002C25265B0000F1D5D79F_DD106B1B7A8020200710671E3B8F9E17_67A5D00A8105A70B6E713488867AE396_3AA200536119DEBF3C7B
            json     = '{"_":"telegram","device_temperature_c":20,"driver":"xeeny","firmware_version":"010500","id":"00000019","media":"radio converter (meter side)","name":"XEEny","status":"INSTALLATION_MODE","timestamp":"1111-11-11T11:11:11Z"}'
            fields   = 'XEEny;00000019;INSTALLATION_MODE;null;null;1111-11-11 11:11.11'
        }
        test {
            args     = 'XEEny xeeny 42038102 NOKEY'
            comment  = 'XEEny on a DZG meter, long tpl with the meter id. Decrypted example from the XEE documentation.'
            telegram = 5B44A560130000000237_8C20B0900F002C2583540000E368DBF9950CE393_720281034247130002B000300710_2F2F07031A0000000000000007833C140000000000000002741A0001671403FD0F0005010D7F050621FC00122F2F2F2F
            json     = '{"_":"telegram","actuality_duration_s":26,"device_temperature_c":20,"driver":"xeeny","firmware_version":"010500","id":"42038102","media":"electricity","name":"XEEny","status":"OK","timestamp":"1111-11-11T11:11:11Z","total_energy_consumption_kwh":0.026,"total_energy_production_kwh":0.02}'
            fields   = 'XEEny;42038102;OK;0.026;0.02;1111-11-11 11:11.11'
        }
        test {
            args     = 'XEEny xeeny 00001234 NOKEY'
            comment  = 'XEEny on an EasyMeter, configured with the XEEny id, the output id is the meter id.'
            telegram = 6B44A560341200000237_8C205E900F002C2531950300A3E7CD0FC182890D_7234127060791611025E00400710_2F2F0703388B0A0000000000871003388B0A00000000008720030000000000000000027403030167170D7F0506218001122F2F2F2F2F2F2F2F2F2F2F2F2F2F2F
            json     = '{"_":"telegram","actuality_duration_s":771,"device_temperature_c":23,"driver":"xeeny","id":"60701234","media":"electricity","name":"XEEny","status":"OK","timestamp":"1111-11-11T11:11:11Z","total_energy_consumption_kwh":691,"total_energy_consumption_tariff_1_kwh":691,"total_energy_consumption_tariff_2_kwh":0}'
            fields   = 'XEEny;60701234;OK;691;null;1111-11-11 11:11.11'
        }
        test {
            args     = 'XEEny xeeny 00001234 NOKEY'
            comment  = 'XEEny firmware 1.6.0 on an EasyMeter during installation. Tpl status 0xa0, bit 7 (manually reset) is ignored. The mfct block now carries XEE tag 0x41.'
            telegram = 6B44A5603412000002378C204C900F002C251F0000006F8C1E004B23AED4_7234127060791611024CA0400710_2F2F070378AA0A000000000087100378AA0A000000000087200300000000000000000274830301671603FD0F0006010D7F07004106218001122F2F2F2F2F2F2F
            json     = '{"_":"telegram","actuality_duration_s":899,"device_temperature_c":22,"driver":"xeeny","firmware_version":"010600","id":"60701234","media":"electricity","name":"XEEny","status":"INSTALLATION_MODE","timestamp":"1111-11-11T11:11:11Z","total_energy_consumption_kwh":699,"total_energy_consumption_tariff_1_kwh":699,"total_energy_consumption_tariff_2_kwh":0}'
            fields   = 'XEEny;60701234;INSTALLATION_MODE;699;null;1111-11-11 11:11.11'
        }
    }
}
