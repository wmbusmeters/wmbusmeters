// Janz eRegister water meter.
// The meaning of the error flag bits is not yet known.
driver {
    name           = janzeregister
    meter_type     = WaterMeter
    default_fields = name,id,status,total_m3,timestamp
    manufacturer   = Janz
    detect {
        mvt = JGF,10,07
    }
    library {
        use = total_m3
        use = target_m3
        use = target_date
        use = meter_datetime
    }
    fields {
        field {
            name       = status
            quantity   = Flags
            info       = 'Meter status from error flags and tpl status field.'
            attributes = STATUS,INCLUDE_TPL_STATUS
            match {
                measurement_type = Instantaneous
                vif_range        = ErrorFlags
            }
            lookup {
                name            = ERROR_FLAGS
                map_type        = BitToString
                mask_bits       = 0xffffffff
                default_message = OK
            }
        }
    }
    tests {
        test {
            args     = 'Janz janzeregister 99999999 NOKEY'
            comment  = 'Janz eRegister'
            telegram = 2e44e6289999999910077a380020252f2f041335000000046d3b0b503b04fd1700000000441300000000426c01012f
            json     = '{"_":"telegram","media":"water","driver":"janzeregister","name":"Janz","id":"99999999","target_m3":0,"target_date":"2000-01-01","total_m3":0.053,"meter_datetime":"2026-11-16 11:59","status":"OK","timestamp":"1111-11-11T11:11:11Z"}'
            fields   = 'Janz;99999999;OK;0.053;1111-11-11 11:11.11'
        }
    }
}
