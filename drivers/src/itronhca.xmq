// Itron Equascan eHCA V2 heat cost allocator.
// The manufacturer specific record 067F is not yet decoded.
driver {
    name           = itronhca
    meter_type     = HeatCostAllocationMeter
    default_fields = name,id,status,allocation_hca,target_hca,target_date,timestamp
    manufacturer   = Itron
    detect {
        mvt = ITW,00,08
    }
    library {
        use = target_hca
        use = target_date
        use = meter_datetime
    }
    fields {
        field {
            name       = status
            quantity   = Flags
            info       = 'Meter status from tpl status field.'
            attributes = STATUS,INCLUDE_TPL_STATUS
        }
        field {
            name     = allocation
            quantity = HCA
            info     = 'The heat cost allocation since the target date.'
            match {
                measurement_type = Instantaneous
                vif_range        = HeatCostAllocation
            }
        }
    }
    tests {
        test {
            args     = 'Room itronhca 23203225 NOKEY'
            telegram = 2C4497262532202300087AB00000A0_0B6E000000066D032B0C183A004B6E270100426C1E36067F2C008F290706
            json     = '{"_":"telegram","media":"heat cost allocation","driver":"itronhca","name":"Room","id":"23203225","allocation_hca":0,"target_date":"2024-06-30","target_hca":127,"meter_datetime":"2024-10-24 12:43:03","status":"OK","timestamp":"1111-11-11T11:11:11Z"}'
            fields   = 'Room;23203225;OK;0;127;2024-06-30;1111-11-11 11:11.11'
        }
    }
}
