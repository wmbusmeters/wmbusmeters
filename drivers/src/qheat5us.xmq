driver {
    name           = qheat5us
    deprecated_by  = qheatv2
    meter_type     = HeatMeter
    default_fields = name,id,status,total_kwh,timestamp
    manufacturer   = Qundis
    library {
        use = total_kwh
        use = target_kwh
        use = target_date
        use = meter_date_at_error
        use = fabrication_no
        use = meter_datetime
    }
    fields {
        field {
            name       = status
            quantity   = Text
            info       = 'Status and error flags'
            attributes = STATUS,INCLUDE_TPL_STATUS
        }
    }
}
