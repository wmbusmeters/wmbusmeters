driver {
    name           = itu80
    meter_type     = WaterMeter
    default_fields = name,id,status,total_m3,timestamp
    detect {
        mvt = ITU,50,07
    }
    library {
        use = total_m3,meter_datetime
    }
    fields {
        field {
            name     = fabrication_no
            quantity = Text
            info     = 'Enhanced Identification.'
            match {
                difvifkey = 0D79
            }
        }
        field {
            name         = remaining_battery_lifetime
            quantity     = Time
            info         = 'Remaining lifetime of the battery.'
            display_unit = d
            match {
                difvifkey = 02FD74
            }
        }
        field {
            name     = negative_volume
            quantity = Volume
            info     = 'Volume only negative.'
            match {
                difvifkey = 04933C
            }
        }
        field {
            name       = status
            quantity   = Text
            info       = 'Status and error flags.'
            attributes = STATUS,INCLUDE_TPL_STATUS
            match {
                difvifkey = 04FD17
            }
            lookup {
                name            = ITU_ERROR_FLAGS
                map_type        = BitToString
                mask_bits       = 0xffffffff
                default_message = OK
            }
        }
        field {
            name     = volume_flow
            quantity = Flow
            info     = 'Volume flow.'
            match {
                difvifkey = 333B
            }
        }
        field {
            name     = flow_temperature
            quantity = Temperature
            info     = 'Flow temperature.'
            match {
                difvifkey = 325A
            }
        }
    }
    tests {
        test {
            args     = 'itu itu80 00493066 8D186A468166FB289AB6DEBD18FC0A46'
            telegram = 514495266630490050078C206C7A8B004025B0847452B2A78BF1A790C5E8408E5FB583315D5D80D268758694158DFE5837F7304A9ACA4A90F7FBFF59564EF1BB63C9852DDB5DAB96B88E650CEAB9639CA3C5E9030100
            json     = '{"_":"telegram","media":"water","meter":"itu80","name":"itu","id":"00493066","flow_temperature_c":3276.7,"negative_volume_m3":0,"remaining_battery_lifetime_d":5526,"total_m3":0,"volume_flow_m3h":8388.607,"fabrication_no":"      I25VC000918","meter_datetime":"2026-07-30 18:12","status":"ITU_ERROR_FLAGS_2000","timestamp":"1111-11-11T11:11:11Z"}'
            fields   = 'itu;00493066;ITU_ERROR_FLAGS_2000;0;1111-11-11 11:11.11'
        }
    }
}
