      "state_topic": "wmbusmeters/{name}",
      "unique_id": "{id}_total_backward_m3",
      "unit_of_measurement": "m³",
      "value_template": "{{ value_json.total_backward_m3 }}"
    }
  },
  "status": {
    "component": "sensor",
    "discovery_payload": {
      "device": {
        "identifiers": ["{id}"],
        "manufacturer": "Apator",
        "model": "Ultrimis v2",
        "name": "wmbusmeters {name}"
      },
      "icon": "mdi:information-outline",
      "json_attributes_topic": "wmbusmeters/{name}",
      "name": "{name} Status",
      "state_topic": "wmbusmeters/{name}",
      "unique_id": "{id}_status",
      "value_template": "{{ value_json.status | default('OK', true) }}"
    }
  },
  "status_problem": {
    "component": "binary_sensor",
    "discovery_payload": {
      "device": {
        "identifiers": ["{id}"],
        "manufacturer": "Apator",
        "model": "Ultrimis v2",
        "name": "wmbusmeters {name}"
      },
      "device_class": "problem",
      "icon": "mdi:alert-circle",
      "json_attributes_topic": "wmbusmeters/{name}",
      "name": "{name} Problem",
      "payload_off": "OK",
      "payload_on": "PROBLEM",
      "state_topic": "wmbusmeters/{name}",
      "unique_id": "{id}_status_problem",
      "value_template": "{% if value_json.status is defined and value_json.status not in ['OK', '', None] %}PROBLEM{% else %}OK{% endif %}"
    }
  },
  "status_dry": {
    "component": "binary_sensor",
    "discovery_payload": {
