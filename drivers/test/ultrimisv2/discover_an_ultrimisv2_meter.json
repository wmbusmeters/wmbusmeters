{
  "total_m3": {
    "component": "sensor",
    "discovery_payload": {
      "device": {
        "identifiers": ["{id}"],
        "manufacturer": "Apator",
        "model": "Ultrimis v2",
        "name": "wmbusmeters {name}"
      },
      "device_class": "water",
      "icon": "mdi:water",
      "json_attributes_topic": "wmbusmeters/{name}",
      "name": "{name} Total",
      "state_class": "total_increasing",
      "state_topic": "wmbusmeters/{name}",
      "unique_id": "{id}_total_m3",
      "unit_of_measurement": "m³",
      "value_template": "{{ value_json.total_m3 }}"
    }
  },
  "target_m3": {
    "component": "sensor",
    "discovery_payload": {
      "device": {
        "identifiers": ["{id}"],
        "manufacturer": "Apator",
        "model": "Ultrimis v2",
        "name": "wmbusmeters {name}"
      },
      "device_class": "water",
      "icon": "mdi:water-check",
      "json_attributes_topic": "wmbusmeters/{name}",
      "name": "{name} Target",
      "state_class": "total_increasing",
      "state_topic": "wmbusmeters/{name}",
      "unique_id": "{id}_target_m3",
      "unit_of_measurement": "m³",
      "value_template": "{{ value_json.target_m3 }}"
    }
  },
  "total_backward_m3": {
    "component": "sensor",
