      "payload_off": "OFF",
      "payload_on": "ON",
      "state_topic": "wmbusmeters/{name}",
      "unique_id": "{id}_status_dry",
      "value_template": "{% if 'DRY' in (value_json.status | default('')) %}ON{% else %}OFF{% endif %}"
