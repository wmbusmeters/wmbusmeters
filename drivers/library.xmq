/* This is the library of fields that can be referenced from
   a driver with library { use = total_m3 }

   The library speeds up creating drivers for meters with mostly
   standardized values. It also helps normalize the names of the fields.

   A field name is short. For a single direction meter with only consumption
   values. Use for example:
   total_m3 (for water/gas consumption volume)
   total_kwh (for energy consumption)
*/
library {
    /* A template info has access to the following variables.
       {media} is replaced with water/gas/electricity/heat/coolant.
       {append_info} is normally empty, but can be replaced with additional driver help.
       Also the entiry info can be replaced.
       library { template { use = total_m3 append_info = 'More helpful info.' }
                 template { use = total_m3 info = 'This is the box volume.' } }

       The change=Increasing or change=Sample is further information
       about the field to be used outside of wmbusmeters. */
    template(id = total_m3)
    {
        name     = total
        quantity = Volume
        info     = 'The total {media} volume recorded.'
        change   = Increasing
        match {
            measurement_type = Instantaneous
            vif_range        = Volume
        }
    }
    template(id = total_kwh)
    {
        name     = total
        quantity = Energy
        info     = 'The total {media} energy recorded.'
        change   = Increasing
        match {
            measurement_type = Instantaneous
            vif_range        = AnyEnergyVIF
        }
    }
    template(id = target_m3)
    {
        name     = target
        quantity = Volume
        info     = 'The {water} volume recorded at the last billing date.'
        match {
            measurement_type = Instantaneous
            vif_range        = Volume
            storage_nr       = 1
        }
    }
    template(id = target_kwh)
    {
        name     = target
        quantity = Energy
        info     = 'The {water} energy recorded at the last billing date.'
        match {
            measurement_type = Instantaneous
            vif_range        = AnyEnergyVIF
            storage_nr       = 1
        }
    }
}
